<?xml version="1.0" encoding="utf-8"?>
<!-- TaskMint launcher foreground: a gold coin with a rising arrow — "money that grows". Art sits inside the adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Second coin peeking from behind (bottom-right) -->
    <path
        android:fillColor="#FBBF24"
        android:strokeColor="#B45309"
        android:strokeWidth="2"
        android:pathData="M75,84m-12,0a12,12 0,1 1,24 0a12,12 0,1 1,-24 0" />

    <!-- Growth arrow (white) sweeping up above the coin -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M26,36 L42,26 L52,31.5 L74,17" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M77.5,14.5 L65.5,15.8 L73.8,25.2 Z" />

    <!-- Main gold coin -->
    <path
        android:strokeColor="#B45309"
        android:strokeWidth="2.5"
        android:pathData="M52,64m-25,0a25,25 0,1 1,50 0a25,25 0,1 1,-50 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="34"
                android:startY="44"
                android:endX="70"
                android:endY="84">
                <item android:color="#FEF3C7" android:offset="0.0" />
                <item android:color="#FBBF24" android:offset="0.55" />
                <item android:color="#F59E0B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Coin inner ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#D97706"
        android:strokeWidth="1.6"
        android:strokeAlpha="0.8"
        android:pathData="M52,64m-20,0a20,20 0,1 1,40 0a20,20 0,1 1,-40 0" />

    <!-- Up arrow embossed on the coin (deep emerald) -->
    <path
        android:fillColor="#065F46"
        android:pathData="M52,48 L61,59.5 L56.5,59.5 L56.5,77 L47.5,77 L47.5,59.5 L43,59.5 Z" />

    <!-- Sparkles -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.95"
        android:pathData="M22,50.5 L23.4,54.6 L27.5,56 L23.4,57.4 L22,61.5 L20.6,57.4 L16.5,56 L20.6,54.6 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.95"
        android:pathData="M86,39.8 L87.1,42.9 L90.2,44 L87.1,45.1 L86,48.2 L84.9,45.1 L81.8,44 L84.9,42.9 Z" />
</vector>
